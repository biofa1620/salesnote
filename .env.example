# 서버 시간대 (날짜·시간 표시 기준)
TZ="Asia/Seoul"

# 외부 시험용 접속 코드 (비워 두면 코드 없이 들어감). 서버에 올릴 때는 꼭 정하세요.
ACCESS_CODE=""

# 데이터베이스 (개발: SQLite 파일 / 운영: PostgreSQL 주소로 교체)
DATABASE_URL="file:./data/salesnote.db"

# AI 기능 연결 방식: mock(가짜 응답) | real(실제 API — src/lib/ai/real.ts 구현 필요)
AI_PROVIDER="mock"

# 기업 정보 연동: mock(샘플 데이터) | real(src/lib/company-info/real.ts 구현 필요)
COMPANY_INFO_PROVIDER="mock"
DART_API_KEY=""
NEWS_API_KEY=""
CREDIT_API_KEY=""

# 실제 API 키 (real 모드에서 사용)
# 명함 OCR: 네이버클라우드 콘솔 > AI Services > CLOVA OCR > 명함(Name Card) 도메인에서 발급
CLOVA_OCR_INVOKE_URL=""
CLOVA_OCR_SECRET=""
STT_API_KEY=""
LLM_API_KEY=""

# 견적서 공급자(우리 회사) 정보
SELLER_NAME="주식회사 다우기술"
SELLER_CEO="김윤덕"
SELLER_ADDRESS="경기도 성남시 수정구 금토로 69 다우디지털스퀘어"
SELLER_BIZ_NO="220-81-02810"
# 회사 CI 이미지 경로 (public/brand/logo.png 에 파일을 넣으면 됨)
SELLER_LOGO="/brand/logo.png"

# 녹음 원본 보관 기간(일)
AUDIO_RETENTION_DAYS="90"

# 업로드 파일 저장 폴더
UPLOAD_DIR="./uploads"

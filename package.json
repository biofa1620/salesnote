{
  "name": "salesnote",
  "version": "0.1.0",
  "private": true,
  "description": "세일즈노트 — 영업사원 모바일 웹 앱(PWA) + 팀장 관리 웹 MVP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "rm -f data/salesnote.db* && npm run db:push && npm run db:seed",
    "cleanup:audio": "tsx --env-file=.env scripts/cleanup-audio.ts",
    "setup": "mkdir -p data uploads && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
